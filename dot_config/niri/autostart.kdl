// ────────────── Startup Applications ──────────────

// Noctalia v5 — native compositor shell
spawn-at-startup "noctalia"

// Polkit authentication agent (GUI password prompts for pkexec/sudo dialogs)
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// Export env to systemd/dbus so portal services can connect to Wayland
spawn-at-startup "sh" "-c" "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=niri"

// Auto-rotate the eDP-1 panel via iio-sensor-proxy orientation events
spawn-at-startup "iio-niri" "listen" "--monitor" "eDP-1"
