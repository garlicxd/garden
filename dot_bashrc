#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '

export LANG=en_US.UTF-8
export LC_TIME=hu_HU.UTF-8
export LC_NUMERIC=en_US.UTF-8
export LC_MONETARY=hu_HU.UTF-8
export LC_PAPER=hu_HU.UTF-8
export LC_MEASUREMENT=hu_HU.UTF-8

export EDITOR="helix"

export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Local scripts (niri helpers, pi launcher)
export PATH="$HOME/.local/bin:$HOME/.local/bin/pi:$PATH"

# Brave browser path for Puppeteer-based tools (marp, etc.)
export CHROME_PATH="/opt/brave-origin-bin/brave"
