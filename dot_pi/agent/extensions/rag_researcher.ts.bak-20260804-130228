/**
 * RAG Researcher - local RAG & search proxy tools
 *
 * Talks to the rag-proxy (FastAPI) on http://127.0.0.1:5000.
 * Provides ranked web search (local RAG + live web, reranked) and
 * crawl-and-index of pages into the local knowledge base.
 */
import { Type } from "@earendil-works/pi-ai";
import { defineTool, type ExtensionAPI } from "@earendil-works/pi-coding-agent";

const PROXY_URL = "http://127.0.0.1:5000";

// Tool 1: ranked web search
const rankedWebSearch = defineTool({
	name: "ranked_web_search",
	label: "Ranked Web Search",
	description:
		"Search the web using the local RAG proxy. Returns ranked and deduplicated results combining local RAG knowledge and live web search.",
	parameters: Type.Object({
		query: Type.String({ description: "Search query" }),
	}),

	async execute(_toolCallId, params, _signal, _onUpdate, _ctx) {
		const resp = await fetch(`${PROXY_URL}/search`, {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({ query: params.query }),
		});
		if (!resp.ok) {
			throw new Error(`Search failed: ${resp.status} ${await resp.text()}`);
		}
		const data = await resp.json();
		return {
			content: [{ type: "text", text: JSON.stringify(data.results, null, 2) }],
			details: { resultCount: data.results.length },
		};
	},
});

// Tool 2: crawl and index page
const crawlAndIndexPage = defineTool({
	name: "crawl_and_index_page",
	label: "Crawl and Index Page",
	description:
		"Crawl a web page and index its content into the local RAG knowledge base for future searches.",
	parameters: Type.Object({
		urls: Type.Array(Type.String({ description: "URL to crawl" }), {
			description: "List of URLs to crawl",
		}),
	}),

	async execute(_toolCallId, params, _signal, _onUpdate, _ctx) {
		const resp = await fetch(`${PROXY_URL}/crawl-and-index`, {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({ urls: params.urls }),
		});
		if (!resp.ok) {
			throw new Error(`Crawl/index failed: ${resp.status} ${await resp.text()}`);
		}
		const data = await resp.json();
		const results = data.results ?? [];
		const indexed = results.filter((r: { status?: string }) => r.status === "indexed").length;
		const failed = results.filter((r: { status?: string }) => r.status === "failed");
		return {
			content: [
				{
					type: "text",
					text:
						`Indexed ${indexed}/${results.length} URLs.` +
						(failed.length
							? ` Failed: ${failed.map((r: { url?: string }) => r.url).join(", ")}`
							: ""),
				},
			],
			details: data,
		};
	},
});

// Tool 3: fetch page content (cache-first, optional force refresh)
const fetchPageContent = defineTool({
	name: "fetch_page_content",
	label: "Fetch Page Content",
	description:
		"Fetch a webpage's Markdown (with YAML frontmatter: url/title/search_summary) from the local RAG proxy. " +
		"Serves from the Qdrant cache when available; set force_fetch=true to bypass the cache and force a live " +
		"crawl + re-index. Optionally pass a search_summary to embed in the frontmatter.",
	parameters: Type.Object({
		url: Type.String({ description: "URL to fetch" }),
		search_summary: Type.Optional(
			Type.String({
				description: "Summary of the page from search results, stored in YAML frontmatter",
			}),
		),
		force_fetch: Type.Optional(
			Type.Boolean({
				description: "Bypass cache and force a live crawl + re-index (default: false)",
			}),
		),
	}),

	async execute(_toolCallId, params, _signal, _onUpdate, _ctx) {
		const resp = await fetch(`${PROXY_URL}/fetch`, {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({
				url: params.url,
				search_summary: params.search_summary,
				force_fetch: params.force_fetch ?? false,
			}),
		});
		if (!resp.ok) {
			throw new Error(`Fetch failed: ${resp.status} ${await resp.text()}`);
		}
		const data = await resp.json();
		return {
			content: [{ type: "text", text: data.markdown ?? JSON.stringify(data) }],
			details: { status: data.status, source: data.source, url: data.url },
		};
	},
});

export default function (pi: ExtensionAPI) {
	pi.registerTool(rankedWebSearch);
	pi.registerTool(crawlAndIndexPage);
	pi.registerTool(fetchPageContent);
}
